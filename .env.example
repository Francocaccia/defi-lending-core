# Copy to .env and fill in. NEVER commit .env.
# Everything here is free-tier / testnet only. No mainnet keys, no real funds.

# Read-only RPC used for mainnet fork tests (any free public endpoint).
# If empty, fork tests are skipped automatically.
MAINNET_RPC_URL=

# Sepolia RPC (free public endpoint) for the optional testnet deploy.
SEPOLIA_RPC_URL=

# Etherscan API key (free tier) for contract verification on Sepolia.
ETHERSCAN_API_KEY=

# THROWAWAY testnet key only (fresh wallet funded from a faucet). Never reuse a real key.
PRIVATE_KEY=
